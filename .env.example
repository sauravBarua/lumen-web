# Server-side URL of the API (use http://api:3001 inside Docker)
API_URL=http://localhost:3001
# Browser-side URL of the API. The API must list this web origin in WEB_ORIGIN (CORS).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Auth.js session encryption key (generate with: openssl rand -base64 32)
AUTH_SECRET=
# Behind a reverse proxy or in Docker:
# AUTH_TRUST_HOST=true